# Subtle-Decline Dashboard Environment Configuration
# Copy this file to .env and modify values as needed

# Dashboard Configuration
DASHBOARD_TITLE="Subtle-Decline Trend Dashboard"
DASHBOARD_LAYOUT="wide"

# Alert Thresholds (0.0 to 1.0)
ALERT_THRESHOLD_LOW=0.20
ALERT_THRESHOLD_MEDIUM=0.35
ALERT_THRESHOLD_HIGH=0.50

# Domain Weights (must sum to 1.0)
WEIGHT_MOBILITY=0.40
WEIGHT_NUTRITION=0.30
WEIGHT_PARTICIPATION=0.30

# System Limits
MIN_CONSECUTIVE_DAYS=2
BASELINE_PERIOD_DAYS=30
COORDINATOR_MAX_CAPACITY=8

# Data Freshness Thresholds (days)
FRESH_DATA_THRESHOLD=1
STALE_DATA_THRESHOLD=3

# Experiment Configuration
EARLY_DETECTION_WINDOW_DAYS=7
TARGET_DETECTION_RATE=0.70

# File Paths (relative to project root)
DATA_DIR="data"
DOCS_DIR="docs" 
TESTS_DIR="tests"

# Logging Configuration
LOG_LEVEL="INFO"
LOG_FILE="dashboard.log"

# Performance Settings
CACHE_TTL_SECONDS=300
MAX_PATIENTS=50
MAX_OBSERVATIONS_PER_PATIENT=365

# Safety Settings
REQUIRE_HUMAN_REVIEW=true
SHOW_SAFETY_DISCLAIMERS=true
ENABLE_SAFE_FALLBACK=true

# Development Settings
DEBUG_MODE=false
SYNTHETIC_DATA_SEED=42

# NOTE: This is a configuration template for demonstration purposes
# In a production deployment, sensitive configuration should be
# properly secured and managed according to organizational policies